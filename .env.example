# docker compose settings - copy to .env and adjust

# Base path the web UI is served under. Must start with "/".
# "/"        -> admin UI at http://host:8000/
# "/scrcpy/" -> admin UI at http://host:8000/scrcpy/
WS_SCRCPY_PATHNAME=/

# Host port mapped to the container's port 8000
WS_SCRCPY_PORT=8000
